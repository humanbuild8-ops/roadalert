# Not read yet — this demo runs entirely in memory (see app/store.py).
# Copy to .env and wire into app/store.py when you swap in the real
# MongoDB-backed store described in the project's architecture slide.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/roadalert
FCM_SERVER_KEY=<firebase-cloud-messaging-server-key>
MAPS_API_KEY=<google-maps-or-osrm-endpoint>
ALERT_RADIUS_KM=5
CONFIRM_VERIFICATIONS_NEEDED=2
